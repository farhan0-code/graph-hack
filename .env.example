# Anthropic API key — only needed for the answer arm of `make benchmark` and for
# `make judge`. Every deterministic result (graph resolution, leakage, residue,
# identity) runs without it; steps that need it are recorded as `not_run`.
ANTHROPIC_API_KEY=

# Optional: point the answer model at an OpenAI-compatible local server instead
# of the Anthropic API. Any --model id that does not start with `claude-` is
# routed here (LM Studio default shown).
CANON_LOCAL_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions

# Optional overrides — defaults match `docker compose up`.
FALKOR_HOST=127.0.0.1
FALKOR_PORT=6379
FALKOR_GRAPH=default

# Optional: where the FastAPI service reads the corpus from, and where the web
# app reaches the API at request time.
CANON_CORPUS_DB=data/corpus.sqlite
CANON_API=http://127.0.0.1:8000
